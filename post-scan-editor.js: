  showToast(message, type = 'info') {
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.textContent = message;
    document.body.appendChild(toast);
    
    setTimeout(() => toast.classList.add('show'), 10);
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }
}

// Global instance
const postScanEditor = new PostScanEditor();

// Make available globally
window.openPostScanEditor = (scanData) => {
  postScanEditor.openEditor(scanData);
};

window.loadSimilarProduct = async (gtin) => {
  const product = await localDB.getProduct(gtin);
  if (product) {
    // Fill form with this product's data
    document.getElementById('post-scan-name').value = product.name;
    document.getElementById('post-scan-brand').value = product.brand || '';
    document.getElementById('post-scan-category').value = product.category || '';
    document.getElementById('post-scan-manufacturer').value = product.manufacturer || '';
    postScanEditor.showToast('✅ Loaded similar product data', 'success');
  }
};

export { postScanEditor, PostScanEditor };
