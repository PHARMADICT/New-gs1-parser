  async loadDataIntoForm(scanData) {
    // Display scan time
    document.getElementById('scan-timestamp').textContent = new Date().toLocaleString();
    document.getElementById('original-gtin-display').textContent = scanData.gtin;

    // Try to get existing product data
    let productData = null;
    try {
      productData = await localDB.getProduct(scanData.gtin);
    } catch (error) {
      console.log('No existing product data');
    }

    // Fill GTIN
    document.getElementById('post-scan-gtin').value = scanData.gtin;

    if (productData) {
      // Load existing product data
      document.getElementById('post-scan-name').value = productData.name || '';
      document.getElementById('post-scan-brand').value = productData.brand || '';
      document.getElementById('post-scan-category').value = productData.category || '';
      document.getElementById('post-scan-batch').value = productData.batch || '';
      document.getElementById('post-scan-expiry').value = productData.expiry || '';
      document.getElementById('post-scan-mfg-date').value = productData.mfgDate || '';
      document.getElementById('post-scan-manufacturer').value = productData.manufacturer || '';
      document.getElementById('post-scan-description').value = productData.description || '';
      document.getElementById('post-scan-quantity').value = productData.quantity || '';
      document.getElementById('post-scan-price').value = productData.price || '';
      document.getElementById('post-scan-shelf-life').value = productData.shelfLife || '';
      
      // Show delete button for existing products
      document.getElementById('delete-post-scan').style.display = 'inline-block';
      
      // Load batch history
      await this.loadBatchHistory(scanData.gtin);
    } else {
      // Try to extract info from GS1 data
      if (scanData.parsedData) {
        const batchData = scanData.parsedData.find(item => item.ai === '10');
        const expiryData = scanData.parsedData.find(item => ['15', '17'].includes(item.ai));
        const prodDateData = scanData.parsedData.find(item => item.ai === '11');
        
        if (batchData) document.getElementById('post-scan-batch').value = batchData.value;
        if (expiryData) document.getElementById('post-scan-expiry').value = this.parseGS1Date(expiryData.value);
        if (prodDateData) document.getElementById('post-scan-mfg-date').value = this.parseGS1Date(prodDateData.value);
      }
    }
    
    // Trigger validation
    this.validateGTIN(scanData.gtin);
  }

  setupEditorListeners() {
    const form = document.getElementById('post-scan-form');
    const gtinInput = document.getElementById('post-scan-gtin');
    const nameInput = document.getElementById('post-scan-name');
    const batchInput = document.getElementById('post-scan-batch');
    const expiryInput = document.getElementById('post-scan-expiry');
    const mfgInput = document.getElementById('post-scan-mfg-date');
    const shelfLifeInput = document.getElementById('post-scan-shelf-life');

    // Form submission
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      this.handleSave();
    });

    // Close buttons
    document.getElementById('close-post-scan').addEventListener('click', () => this.closeEditor());
    document.getElementById('cancel-post-scan').addEventListener('click', () => this.closeEditor());

    // GTIN validation and change detection
    gtinInput.addEventListener('input', async (e) => {
      const newGTIN = e.target.value;
      this.validateGTIN(newGTIN);
      
      if (newGTIN !== this.originalGTIN && newGTIN.length >= 8) {
        document.getElementById('gtin-change-warning').style.display = 'block';
        await this.checkDuplicateGTIN(newGTIN);
      } else {
        document.getElementById('gtin-change-warning').style.display = 'none';
        document.getElementById('duplicate-gtin-warning').style.display = 'none';
      }
    });

    // Copy GTIN
    document.getElementById('copy-gtin').addEventListener('click', () => {
      gtinInput.select();
      document.execCommand('copy');
      this.showToast('GTIN copied!', 'success');
    });

    // Reset GTIN
    document.getElementById('reset-gtin').addEventListener('click', () => {
      gtinInput.value = this.originalGTIN;
      document.getElementById('gtin-change-warning').style.display = 'none';
      this.validateGTIN(this.originalGTIN);
    });

    // Fuzzy name matching
    nameInput.addEventListener('input', () => {
      this.fuzzyMatchName(nameInput.value);
    });

    // Batch input
    batchInput.addEventListener('input', () => {
      this.suggestBatchFormat(batchInput.value);
    });

    // Expiry calculations
    expiryInput.addEventListener('change', () => {
      this.calculateShelfLife(mfgInput.value, expiryInput.value);
    });

    mfgInput.addEventListener('change', () => {
      this.calculateShelfLife(mfgInput.value, expiryInput.value);
    });

    shelfLifeInput.addEventListener('change', () => {
      if (mfgInput.value && shelfLifeInput.value) {
        this.calculateExpiryFromShelfLife(mfgInput.value, parseInt(shelfLifeInput.value));
      }
    });

    // Quick action buttons
    document.getElementById('quick-update-batch').addEventListener('click', () => {
      this.quickUpdateBatchOnly();
    });

    document.getElementById('quick-update-expiry').addEventListener('click', () => {
      this.quickUpdateExpiryOnly();
    });

    document.getElementById('quick-copy-product').addEventListener('click', () => {
      this.quickCopyToNewGTIN();
    });

    document.getElementById('quick-mark-expired').addEventListener('click', () => {
      this.quickMarkExpired();
    });

    // Delete button
    const deleteBtn = document.getElementById('delete-post-scan');
    if (deleteBtn) {
      deleteBtn.addEventListener('click', () => this.handleDelete());
    }
  }

  validateGTIN(gtin) {
    const badge = document.getElementById('gtin-validation');
    
    if (!gtin) {
      badge.textContent = '';
      badge.className = 'validation-badge';
      return false;
    }

    const validLengths = [8, 12, 13, 14];
    const isNumeric = /^\d+$/.test(gtin);
    const isValidLength = validLengths.includes(gtin.length);

    if (isNumeric && isValidLength) {
      badge.textContent = '✓ Valid';
      badge.className = 'validation-badge valid';
      return true;
    } else if (isNumeric) {
      badge.textContent = '⚠ Wrong length';
      badge.className = 'validation-badge warning';
      return false;
    } else {
      badge.textContent = '✗ Invalid';
      badge.className = 'validation-badge invalid';
      return false;
    }
  }

  async checkDuplicateGTIN(gtin) {
    try {
      const existing = await localDB.getProduct(gtin);
      if (existing && gtin !== this.originalGTIN) {
        document.getElementById('duplicate-gtin-warning').style.display = 'block';
        
        // Setup load button
        document.getElementById('load-existing-gtin').onclick = async () => {
          await this.loadDataIntoForm({ gtin: gtin, parsedData: null });
          this.originalGTIN = gtin;
          document.getElementById('duplicate-gtin-warning').style.display = 'none';
          this.showToast('Loaded existing product data', 'info');
        };
      } else {
        document.getElementById('duplicate-gtin-warning').style.display = 'none';
      }
    } catch (error) {
      document.getElementById('duplicate-gtin-warning').style.display = 'none';
    }
  }

  async fuzzyMatchName(input) {
    if (input.length < 2) {
      document.getElementById('name-similarity').innerHTML = '';
      return;
    }

    // Get all products
    await localDB.init();
    const db = localDB.db;
    const transaction = db.transaction(['products'], 'readonly');
    const store = transaction.objectStore('products');
    const allProducts = await new Promise(resolve => {
      const request = store.getAll();
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => resolve([]);
    });

    // Calculate similarity
    const matches = allProducts
      .map(product => ({
        ...product,
        similarity: this.calculateSimilarity(input.toLowerCase(), product.name.toLowerCase())
      }))
      .filter(p => p.similarity >= 0.6) // 60% or more similarity
      .sort((a, b) => b.similarity - a.similarity)
      .slice(0, 5);

    this.displaySimilarityMatches(matches);
  }

  calculateSimilarity(str1, str2) {
    // Levenshtein distance for similarity
    const longer = str1.length > str2.length ? str1 : str2;
    const shorter = str1.length > str2.length ? str2 : str1;
    
    if (longer.length === 0) return 1.0;
    
    const editDistance = this.levenshteinDistance(longer, shorter);
    return (longer.length - editDistance) / longer.length;
  }

  levenshteinDistance(str1, str2) {
    const matrix = [];

    for (let i = 0; i <= str2.length; i++) {
      matrix[i] = [i];
    }

    for (let j = 0; j <= str1.length; j++) {
      matrix[0][j] = j;
    }

    for (let i = 1; i <= str2.length; i++) {
      for (let j = 1; j <= str1.length; j++) {
        if (str2.charAt(i - 1) === str1.charAt(j - 1)) {
          matrix[i][j] = matrix[i - 1][j - 1];
        } else {
          matrix[i][j] = Math.min(
            matrix[i - 1][j - 1] + 1,
            matrix[i][j - 1] + 1,
            matrix[i - 1][j] + 1
          );
        }
      }
    }

    return matrix[str2.length][str1.length];
  }

  displaySimilarityMatches(matches) {
    const container = document.getElementById('name-similarity');
    
    if (matches.length === 0) {
      container.innerHTML = '';
      return;
    }

    container.innerHTML = `
      <div class="similarity-header">💡 Similar products (${matches[0].similarity >= 0.8 ? 'High' : 'Moderate'} match):</div>
      ${matches.map(match => `
        <div class="similarity-item" onclick="window.loadSimilarProduct('${match.gtin}')">
          <div class="similarity-info">
            <strong>${match.name}</strong>
            <small>${match.brand || 'No brand'} • GTIN: ${match.gtin}</small>
          </div>
          <div class="similarity-score">${Math.round(match.similarity * 100)}%</div>
        </div>
      `).join('')}
    `;
  }

