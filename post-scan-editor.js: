  calculateShelfLife(mfgDate, expiryDate) {
    if (!mfgDate || !expiryDate) return;

    const mfg = new Date(mfgDate);
    const exp = new Date(expiryDate);
    const diffTime = Math.abs(exp - mfg);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    document.getElementById('post-scan-shelf-life').value = diffDays;
    
    const calcDiv = document.getElementById('expiry-calc');
    calcDiv.innerHTML = `<small class="success-text">✓ Shelf life: ${diffDays} days</small>`;
  }

  calculateExpiryFromShelfLife(mfgDate, shelfLifeDays) {
    if (!mfgDate || !shelfLifeDays) return;

    const mfg = new Date(mfgDate);
    mfg.setDate(mfg.getDate() + shelfLifeDays);
    
    const expiryFormatted = mfg.toISOString().split('T')[0];
    document.getElementById('post-scan-expiry').value = expiryFormatted;
    
    const calcDiv = document.getElementById('expiry-calc');
    calcDiv.innerHTML = `<small class="success-text">✓ Calculated expiry: ${expiryFormatted}</small>`;
  }

  suggestBatchFormat(input) {
    // Suggest common batch formats
    if (input.length < 2) return;
    
    const suggestions = [];
    
    // LOT + number
    if (!input.toUpperCase().startsWith('LOT')) {
      suggestions.push(`LOT${input}`);
    }
    
    // Add date
    const today = new Date();
    const dateStr = today.toISOString().split('T')[0].replace(/-/g, '');
    if (!input.includes(dateStr)) {
      suggestions.push(`${input}-${dateStr}`);
    }
    
    // Show suggestions (you can enhance this)
  }

  parseGS1Date(gs1Date) {
    // Convert YYMMDD to YYYY-MM-DD
    if (gs1Date.length === 6) {
      const yy = gs1Date.substring(0, 2);
      const mm = gs1Date.substring(2, 4);
      const dd = gs1Date.substring(4, 6);
      const year = parseInt(yy) > 50 ? `19${yy}` : `20${yy}`;
      return `${year}-${mm}-${dd}`;
    }
    return '';
  }

  async handleSave() {
    const form = document.getElementById('post-scan-form');
    const formData = new FormData(form);
    
    const newGTIN = formData.get('gtin');
    const gtinChanged = newGTIN !== this.originalGTIN;
    
    const productData = {
      gtin: newGTIN,
      name: formData.get('name'),
      brand: formData.get('brand') || null,
      category: formData.get('category') || null,
      batch: formData.get('batch') || null,
      expiry: formData.get('expiry') || null,
      mfgDate: formData.get('mfgDate') || null,
      shelfLife: formData.get('shelfLife') || null,
      manufacturer: formData.get('manufacturer') || null,
      description: formData.get('description') || null,
      quantity: formData.get('quantity') || null,
      price: formData.get('price') || null,
      source: 'Manual Edit',
      lastUpdated: new Date().toISOString()
    };

    try {
      // Save to database
      await localDB.saveProduct(productData);
      
      // If GTIN changed, delete old entry
      if (gtinChanged && this.originalGTIN !== newGTIN) {
        try {
          await localDB.init();
          const db = localDB.db;
          const transaction = db.transaction(['products'], 'readwrite');
          const store = transaction.objectStore('products');
          await store.delete(this.originalGTIN);
          
          this.showToast(`✅ Product moved from ${this.originalGTIN} to ${newGTIN}`, 'success');
        } catch (error) {
          console.error('Error deleting old GTIN:', error);
        }
      } else {
        this.showToast('✅ Product updated successfully!', 'success');
      }
      
      // Close editor
      this.closeEditor();
      
      // Refresh display if function exists
      if (window.refreshCurrentProduct) {
        window.refreshCurrentProduct(newGTIN);
      }
    } catch (error) {
      console.error('Save error:', error);
      this.showToast('❌ Failed to save: ' + error.message, 'error');
    }
  }

  async handleDelete() {
    if (!confirm(`Delete this product?\n\nGTIN: ${this.originalGTIN}\n\nThis cannot be undone.`)) {
      return;
    }

    try {
      await localDB.init();
      const db = localDB.db;
      const transaction = db.transaction(['products'], 'readwrite');
      const store = transaction.objectStore('products');
      await store.delete(this.originalGTIN);
      
      this.showToast('🗑️ Product deleted', 'success');
      this.closeEditor();
    } catch (error) {
      this.showToast('❌ Delete failed: ' + error.message, 'error');
    }
  }

