import { Html5Qrcode } from 'html5-qrcode';
import GS1Parser from './gs1-parser.js';
import { interpretWithAI, setAPIKey } from './ai-integration.js';
import { fetchProductDataEnhanced, importProductsFromCSV, importProductsFromJSON, exportProductsToJSON, localDB } from './product-api.js';
import { initProductEditor, openProductEditor } from './product-editor.js';
import { postScanEditor } from './post-scan-editor.js';

// Application state
let html5QrCode = null;
let parser = new GS1Parser();
let scanHistory = [];
let isScanning = false;
let lastScanData = null; // Store last scan for restoration

// DOM elements
const scannerContainer = document.getElementById('scanner-container');
const toggleScannerBtn = document.getElementById('toggle-scanner');
const scanResults = document.getElementById('scan-results');
const aiResponse = document.getElementById('ai-response');
const aiLoading = document.getElementById('ai-loading');
const scanHistoryContainer = document.getElementById('scan-history');
const clearHistoryBtn = document.getElementById('clear-history');

// Initialize application
async function init() {
  console.log('Initializing GS1 Scanner...');
  
  // Initialize local product database
  try {
    await localDB.init();
    console.log('✅ Product database initialized');
  } catch (error) {
    console.error('Failed to initialize product database:', error);
  }
  
  // Initialize product editor
  initProductEditor();
  console.log('✅ Product editor initialized');
  
  // Load API key from localStorage if exists
  const savedApiKey = localStorage.getItem('ai_api_key');
  if (savedApiKey) {
    setAPIKey(savedApiKey);
  } else {
    promptForAPIKey();
  }
  
  // Load scan history
  await loadHistory();
  
  // Restore last scan if app was closed
  restoreLastScan();
  
  // Set up event listeners
  toggleScannerBtn.addEventListener('click', toggleScanner);
  clearHistoryBtn.addEventListener('click', clearHistory);
  
  // Add product import/export listeners
  setupProductImportExport();
  
  // Auto-backup every 5 minutes
  setInterval(autoBackup, 5 * 60 * 1000);
  
  // Register service worker
  registerServiceWorker();
  
  // Check for PWA install prompt
  setupPWAInstall();
  
  // Monitor online/offline status
  setupNetworkMonitor();
  
  // Show welcome message if first time
  if (!localStorage.getItem('app_initialized')) {
    showWelcomeMessage();
    localStorage.setItem('app_initialized', 'true');
  }
}

// Welcome message for first-time users
function showWelcomeMessage() {
  const message = document.createElement('div');
  message.className = 'welcome-message';
  message.innerHTML = `
    <div class="welcome-content">
      <h2>👋 Welcome to GS1 Scanner!</h2>
      <p>Your scan history is automatically saved and will be here when you return.</p>
      <p>Product data is cached locally for offline use.</p>
      <button onclick="this.parentElement.parentElement.remove()">Got it!</button>
    </div>
  `;
  document.body.appendChild(message);
  
  setTimeout(() => {
    message.remove();
  }, 10000);
}

// Auto-backup function
async function autoBackup() {
  try {
    // Save scan history to localStorage
    localStorage.setItem('scan_history', JSON.stringify(scanHistory));
    
    // Save last scan state
    if (lastScanData) {
      localStorage.setItem('last_scan', JSON.stringify(lastScanData));
    }
    
    console.log('✅ Auto-backup completed');
  } catch (error) {
    console.error('Auto-backup failed:', error);
  }
}

// Restore last scan when app reopens
function restoreLastScan() {
  try {
    const lastScan = localStorage.getItem('last_scan');
    if (lastScan) {
      const data = JSON.parse(lastScan);
      console.log('Restoring last scan:', data.summary);
      
      // Display the last scan
      if (data.parsedData) {
        displayResults(data.parsedData);
      }
      if (data.gtin) {
        fetchAndDisplayProductInfo(data.gtin);
      }
      if (data.aiResponse) {
        aiResponse.innerHTML = `<p>${data.aiResponse}</p>`;
      }
      
      showMessage('Previous scan restored', 'info');
    }
  } catch (error) {
    console.error('Failed to restore last scan:', error);
  }
}

// Setup product import/export functionality
function setupProductImportExport() {
  // Import CSV button
  const importCSVBtn = document.getElementById('import-csv-btn');
  const csvFileInput = document.getElementById('csv-file-input');
  
  if (importCSVBtn && csvFileInput) {
    importCSVBtn.addEventListener('click', () => csvFileInput.click());
    csvFileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file) {
        try {
          showMessage('Importing products from CSV...', 'info');
          const result = await importProductsFromCSV(file);
          showMessage(`✅ Imported ${result.imported} products. Failed: ${result.failed}`, 'success');
          
          // Clear the file input
          csvFileInput.value = '';
        } catch (error) {
          showMessage('❌ Failed to import CSV: ' + error.message, 'error');
        }
      }
    });
  }
  
  // Import JSON button
  const importJSONBtn = document.getElementById('import-json-btn');
  const jsonFileInput = document.getElementById('json-file-input');
  
  if (importJSONBtn && jsonFileInput) {
    importJSONBtn.addEventListener('click', () => jsonFileInput.click());
    jsonFileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file) {
        try {
          showMessage('Importing products from JSON...', 'info');
          const result = await importProductsFromJSON(file);
          showMessage(`✅ Imported ${result.imported} products. Failed: ${result.failed}`, 'success');
          
          // Clear the file input
          jsonFileInput.value = '';
        } catch (error) {
          showMessage('❌ Failed to import JSON: ' + error.message, 'error');
        }
      }
    });
  }
  
  // Export JSON button
  const exportJSONBtn = document.getElementById('export-json-btn');
  if (exportJSONBtn) {
    exportJSONBtn.addEventListener('click', async () => {
      try {
        const count = await exportProductsToJSON();
        showMessage(`✅ Exported ${count} products`, 'success');
      } catch (error) {
        showMessage('❌ Failed to export: ' + error.message, 'error');
      }
    });
  }
  
  // Export scan history button
  const exportHistoryBtn = document.getElementById('export-history-btn');
  if (exportHistoryBtn) {
    exportHistoryBtn.addEventListener('click', exportScanHistory);
  }
}

// Export scan history
function exportScanHistory() {
  try {
    const json = JSON.stringify(scanHistory, null, 2);
    const blob = new Blob([json], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    
    const a = document.createElement('a');
    a.href = url;
    a.download = `scan-history-${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    
    showMessage(`✅ Exported ${scanHistory.length} scans`, 'success');
  } catch (error) {
    showMessage('❌ Failed to export history: ' + error.message, 'error');
  }
}

// Prompt user for API key
function promptForAPIKey() {
  const apiKey = prompt(
    'Enter your AI API key (OpenAI, Anthropic, Google, or Cohere):\n\n' +
    'You can get a free API key from:\n' +
    '- OpenAI: https://platform.openai.com/api-keys\n' +
    '- Google: https://makersuite.google.com/app/apikey\n' +
    '- Anthropic: https://console.anthropic.com/\n\n' +
    'Leave blank to use without AI interpretation.'
  );
  
  if (apiKey && apiKey.trim()) {
    localStorage.setItem('ai_api_key', apiKey.trim());
    setAPIKey(apiKey.trim());
    showMessage('✅ API key saved successfully!', 'success');
  }
}

// Toggle scanner on/off
async function toggleScanner() {
  if (isScanning) {
    await stopScanner();
  } else {
    await startScanner();
  }
}

// Start scanner
async function startScanner() {
  try {
    if (!html5QrCode) {
      html5QrCode = new Html5Qrcode('scanner-container');
    }
    
    const config = {
      fps: 10,
      qrbox: { width: 250, height: 250 },
      aspectRatio: 1.0
    };
    
    await html5QrCode.start(
      { facingMode: 'environment' },
      config,
      onScanSuccess,
      onScanError
    );
    
    isScanning = true;
    toggleScannerBtn.textContent = 'Stop Scanner';
    toggleScannerBtn.classList.remove('btn-primary');
    toggleScannerBtn.classList.add('btn-secondary');
    
    console.log('Scanner started');
  } catch (error) {
    console.error('Failed to start scanner:', error);
    showMessage('❌ Failed to start scanner. Please check camera permissions.', 'error');
  }
}

// Stop scanner
async function stopScanner() {
  try {
    if (html5QrCode && isScanning) {
      await html5QrCode.stop();
      isScanning = false;
      toggleScannerBtn.textContent = 'Start Scanner';
      toggleScannerBtn.classList.remove('btn-secondary');
      toggleScannerBtn.classList.add('btn-primary');
      console.log('Scanner stopped');
    }
  } catch (error) {
    console.error('Failed to stop scanner:', error);
  }
}

// Handle successful scan
async function onScanSuccess(decodedText, decodedResult) {
  console.log('Scan successful:', decodedText);
  
  // Pause scanning briefly to avoid multiple scans
  if (html5QrCode && isScanning) {
    html5QrCode.pause();
    setTimeout(() => {
      if (html5QrCode && isScanning) {
        html5QrCode.resume();
      }
    }, 2000);
  }
  
  // Parse GS1 data
  try {
    const parsed = parser.parse(decodedText);
    
    if (parsed.length === 0) {
      showMessage('⚠️ No GS1 data found in barcode.', 'warning');
      return;
    }
    
    // Extract GTIN for product lookup
    const gtinData = parsed.find(item => item.ai === '01');
    const gtin = gtinData ? gtinData.value : null;
    
    // Display results
    displayResults(parsed);
    
    // Fetch product information
    let productData = null;
    if (gtin) {
      productData = await fetchAndDisplayProductInfo(gtin);
    }
    
    // Get AI interpretation
    const aiResponseText = await getAIInterpretation(parsed, productData);
    
    // Save to history with all data
    addToHistory(decodedText, parsed, gtin, productData, aiResponseText);
    
    // Save as last scan (for restoration)
    lastScanData = {
      timestamp: new Date().toISOString(),
      rawData: decodedText,
      parsedData: parsed,
      gtin: gtin,
      productData: productData,
      aiResponse: aiResponseText,
      summary: generateSummary(parsed, productData)
    };
    localStorage.setItem('last_scan', JSON.stringify(lastScanData));
    
    // Show quick edit button
    showQuickEditButton(lastScanData);
    
    // Show success message
    showMessage('✅ Barcode scanned successfully!', 'success');
    
  } catch (error) {
    console.error('Parse error:', error);
    showMessage('❌ Error parsing barcode data.', 'error');
  }
}

// Fetch and display product information (NEW FORMAT)
async function fetchAndDisplayProductInfo(gtin) {
  const productInfoDiv = document.getElementById('product-info');
  const productLoadingDiv = document.getElementById('product-loading');
  
  if (!productInfoDiv || !productLoadingDiv) {
    return null;
  }
  
  // Show loading
  productLoadingDiv.style.display = 'block';
  productInfoDiv.innerHTML = '';
  
  try {
    console.log('Fetching product data for GTIN:', gtin);
    const productData = await fetchProductDataEnhanced(gtin);
    
    // Hide loading
    productLoadingDiv.style.display = 'none';
    
    if (productData) {
      displayProductInfo(productData);
      return productData;
    } else {
      productInfoDiv.innerHTML = `
        <div class="no-product-info">
          <div class="icon">📦</div>
          <h3>No Product Information Found</h3>
          <p>GTIN: <strong>${gtin}</strong></p>
          <p class="hint">Add product information manually or import from CSV/JSON</p>
          <div style="display: flex; gap: 10px; justify-content: center; margin-top: 20px;">
            <button onclick="window.openProductEditor('${gtin}')" class="add-product-btn">
              Add Product Manually
            </button>
            <button onclick="document.getElementById('import-csv-btn').click()" class="btn btn-secondary">
              Import CSV
            </button>
          </div>
        </div>
      `;
      return null;
    }
  } catch (error) {
    console.error('Failed to fetch product data:', error);
    productLoadingDiv.style.display = 'none';
    productInfoDiv.innerHTML = `
      <div class="error-container">
        <p class="error-message">❌ Failed to fetch product information</p>
        <small>${error.message}</small>
      </div>
    `;
    return null;
  }
}

// Display product information (IMPROVED FORMAT)
function displayProductInfo(product) {
  const productInfoDiv = document.getElementById('product-info');
  
  let html = '<div class="product-card">';
  
  // Top section with image and main info
  html += '<div class="product-main">';
  
  // Product image (left side)
  if (product.imageUrl) {
    html += `
      <div class="product-image-container">
        <img src="${product.imageUrl}" alt="${product.name}" 
             onerror="this.parentElement.innerHTML='<div class=image-placeholder>📦</div>'">
      </div>
    `;
  } else {
    html += '<div class="product-image-container"><div class="image-placeholder">📦</div></div>';
  }
  
  // Product info (right side)
  html += '<div class="product-info-main">';
  html += `<h3 class="product-name">${product.name}</h3>`;
  
  if (product.brand) {
    html += `<p class="product-brand">🏷️ ${product.brand}</p>`;
  }
  
  if (product.manufacturer) {
    html += `<p class="product-manufacturer">🏭 ${product.manufacturer}</p>`;
  }
  
  if (product.category) {
    html += `<span class="product-category">${product.category}</span>`;
  }
  
  html += '</div>'; // Close product-info-main
  html += '</div>'; // Close product-main
  
  // Description
  if (product.description) {
    html += `
      <div class="product-description">
        <p>${product.description}</p>
      </div>
    `;
  }
  
  // Details grid
  html += '<div class="product-details-grid">';
  
  // Ingredients
  if (product.ingredients) {
    html += `
      <div class="detail-box">
        <div class="detail-label">📋 Ingredients</div>
        <div class="detail-value">${product.ingredients}</div>
      </div>
    `;
  }
  
  // Allergens (highlighted)
  if (product.allergens) {
    html += `
      <div class="detail-box allergen-warning">
        <div class="detail-label">⚠️ Allergens</div>
        <div class="detail-value"><strong>${product.allergens}</strong></div>
      </div>
    `;
  }
  
  // Nutrition facts
  if (product.nutrition && Object.keys(product.nutrition).length > 0) {
    html += '<div class="detail-box nutrition-box">';
    html += '<div class="detail-label">📊 Nutrition Facts</div>';
    html += '<div class="nutrition-table">';
    
    for (const [key, value] of Object.entries(product.nutrition)) {
      if (value) {
        const formattedKey = key.charAt(0).toUpperCase() + key.slice(1).replace(/([A-Z])/g, ' $1');
        html += `
          <div class="nutrition-row">
            <span class="nutrition-key">${formattedKey}</span>
            <span class="nutrition-value">${value}</span>
          </div>
        `;
      }
    }
    
    html += '</div></div>';
  }
  
  html += '</div>'; // Close product-details-grid
  
  // Quick Edit Bar
  html += `
    <div class="quick-edit-bar">
      <button class="btn-edit-product" onclick="window.openProductEditor('${product.gtin}', ${JSON.stringify(product).replace(/"/g, '&quot;')})">
        ✏️ Edit Product
      </button>
      <button class="btn-add-similar" onclick="window.openProductEditor('', ${JSON.stringify(product).replace(/"/g, '&quot;')})">
        ➕ Add Similar Product
      </button>
    </div>
  `;
  
  // Footer with source
  html += `
    <div class="product-footer">
      <span class="data-source">
        📊 Source: ${product.source}
        ${product.cached ? ' (Cached - Available Offline)' : ''}
      </span>
      <span class="scan-time">🕐 ${new Date().toLocaleTimeString()}</span>
    </div>
  `;
  
  html += '</div>'; // Close product-card
  
  productInfoDiv.innerHTML = html;
}

// Handle scan error
function onScanError(error) {
  if (error.includes('No MultiFormat Readers were able to detect the code')) {
    return;
  }
  console.warn('Scan error:', error);
}

// Display scan results
function displayResults(parsedData) {
  scanResults.innerHTML = '';
  
  if (parsedData.length === 0) {
    scanResults.innerHTML = '<p class="placeholder">No GS1 data detected.</p>';
    return;
  }
  
  // Create a card for scan results
  const card = document.createElement('div');
  card.className = 'scan-results-card';
  
  let html = '<h3>📊 GS1 Data Decoded</h3>';
  html += '<div class="gs1-items">';
  
  parsedData.forEach(item => {
    html += `
      <div class="gs1-item">
        <div class="gs1-header">
          <span class="gs1-name">${item.name}</span>
          <span class="gs1-ai">AI ${item.ai}</span>
        </div>
        <div class="gs1-value">${item.value}</div>
        <div class="gs1-description">${item.description}</div>
      </div>
    `;
  });
  
  html += '</div>';
  card.innerHTML = html;
  scanResults.appendChild(card);
}

// Get AI interpretation (returns response text)
async function getAIInterpretation(parsedData, productData) {
  const apiKey = localStorage.getItem('ai_api_key');
  if (!apiKey) {
    aiResponse.innerHTML = '<p class="placeholder">💡 AI interpretation disabled. Add API key in settings.</p>';
    return null;
  }
  
  aiLoading.style.display = 'block';
  aiResponse.innerHTML = '';
  
  try {
    // Enhance AI prompt with product data if available
    let enhancedData = [...parsedData];
    if (productData) {
      enhancedData.push({
        ai: 'PRODUCT',
        name: 'Product Name',
        value: productData.name,
        description: 'Identified product from database'
      });
    }
    
    const interpretation = await interpretWithAI(enhancedData);
    aiLoading.style.display = 'none';
    aiResponse.innerHTML = `<p>${interpretation.replace(/\n/g, '<br>')}</p>`;
    
    return interpretation;
  } catch (error) {
    console.error('AI interpretation error:', error);
    aiLoading.style.display = 'none';
    
    let errorMessage = '❌ Failed to get AI interpretation.';
    if (error.message.includes('Rate limit')) {
      errorMessage = `⏰ ${error.message}`;
    } else if (error.message.includes('API')) {
      errorMessage = '🔑 API error. Check your API key in settings.';
    }
    
    aiResponse.innerHTML = `<p class="error-message">${errorMessage}</p>`;
    return null;
  }
}

// Add scan to history (PERSISTENT)
function addToHistory(rawData, parsedData, gtin, productData, aiResponseText) {
  const historyItem = {
    timestamp: new Date().toISOString(),
    rawData: rawData,
    parsedData: parsedData,
    gtin: gtin,
    productData: productData,
    aiResponse: aiResponseText,
    summary: generateSummary(parsedData, productData)
  };
  
  scanHistory.unshift(historyItem);
  
  // Limit history to 100 items
  if (scanHistory.length > 100) {
    scanHistory = scanHistory.slice(0, 100);
  }
  
  // Save to localStorage immediately
  try {
    localStorage.setItem('scan_history', JSON.stringify(scanHistory));
    console.log('✅ History saved:', scanHistory.length, 'items');
  } catch (error) {
    console.error('Failed to save history:', error);
    // If localStorage is full, try to clear old items
    if (error.name === 'QuotaExceededError') {
      scanHistory = scanHistory.slice(0, 50);
      localStorage.setItem('scan_history', JSON.stringify(scanHistory));
    }
  }
  
  displayHistory();
}

// Generate summary for history item
function generateSummary(parsedData, productData) {
  if (productData && productData.name) {
    return `📦 ${productData.name}`;
  }
  
  const summaryParts = [];
  
  parsedData.forEach(item => {
    if (['GTIN', 'SERIAL', 'BATCH/LOT'].includes(item.name)) {
      summaryParts.push(`${item.name}: ${item.value}`);
    }
  });
  
  return summaryParts.join(' | ') || '📊 GS1 Scan';
}

// Display scan history (IMPROVED)
function displayHistory() {
  if (scanHistory.length === 0) {
    scanHistoryContainer.innerHTML = `
      <div class="empty-state">
        <div class="empty-icon">📋</div>
        <p>No scan history yet.</p>
        <p class="hint">Your scans will be saved automatically</p>
      </div>
    `;
    return;
  }
  
  scanHistoryContainer.innerHTML = `
    <div class="history-header">
      <span>${scanHistory.length} scan${scanHistory.length !== 1 ? 's' : ''} saved</span>
      <button id="export-history-btn" class="btn-small">Export</button>
    </div>
  `;
  
  scanHistory.forEach((item, index) => {
    const historyItem = document.createElement('div');
    historyItem.className = 'history-item-card';
    
    const date = new Date(item.timestamp);
    const timeAgo = getTimeAgo(date);
    
    historyItem.innerHTML = `
      <div class="history-content">
        <div class="history-main">
          <div class="history-summary">${item.summary}</div>
          <div class="history-time">🕐 ${timeAgo}</div>
        </div>
        ${item.productData ? `
          <div class="history-product-preview">
            ${item.productData.imageUrl ? 
              `<img src="${item.productData.imageUrl}" alt="" onerror="this.style.display='none'">` : 
              '<span class="mini-icon">📦</span>'
            }
            <span>${item.productData.brand || ''}</span>
          </div>
        ` : ''}
      </div>
      <div class="history-actions">
        <button class="btn-view" data-index="${index}">View</button>
      </div>
    `;
    
    historyItem.querySelector('.btn-view').addEventListener('click', () => {
      loadHistoryItem(item);
    });
    
    scanHistoryContainer.appendChild(historyItem);
  });
  
  // Re-attach export button listener
  const exportBtn = document.getElementById('export-history-btn');
  if (exportBtn) {
    exportBtn.addEventListener('click', exportScanHistory);
  }
}

// Load history item
function loadHistoryItem(item) {
  console.log('Loading history item:', item.summary);
  
  if (item.parsedData) {
    displayResults(item.parsedData);
  }
  
  if (item.productData) {
    displayProductInfo(item.productData);
  } else if (item.gtin) {
    fetchAndDisplayProductInfo(item.gtin);
  }
  
  if (item.aiResponse) {
    aiResponse.innerHTML = `<p>${item.aiResponse.replace(/\n/g, '<br>')}</p>`;
  }
  
  // Scroll to top
  window.scrollTo({ top: 0, behavior: 'smooth' });
  
  showMessage('📋 History item loaded', 'info');
}

// Get time ago string
function getTimeAgo(date) {
  const seconds = Math.floor((new Date() - date) / 1000);
  
  if (seconds < 60) return 'Just now';
  if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
  if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
  if (seconds < 604800) return `${Math.floor(seconds / 86400)}d ago`;
  
  return date.toLocaleDateString();
}

// Load history from localStorage
async function loadHistory() {
  try {
    const saved = localStorage.getItem('scan_history');
    if (saved) {
      scanHistory = JSON.parse(saved);
      console.log('✅ Loaded history:', scanHistory.length, 'items');
      displayHistory();
    }
  } catch (error) {
    console.error('Failed to load history:', error);
    scanHistory = [];
  }
}

// Clear history
function clearHistory() {
  if (confirm('⚠️ Are you sure you want to clear all scan history?\n\nThis cannot be undone.')) {
    scanHistory = [];
    localStorage.removeItem('scan_history');
    localStorage.removeItem('last_scan');
    displayHistory();
    showMessage('🗑️ History cleared.', 'success');
  }
}

// Show message
function showMessage(message, type = 'info') {
  const messageDiv = document.createElement('div');
  messageDiv.className = `toast-message toast-${type}`;
  messageDiv.textContent = message;
  
  document.body.appendChild(messageDiv);
  
  // Animate in
  setTimeout(() => messageDiv.classList.add('show'), 10);
  
  // Remove after 3 seconds
  setTimeout(() => {
    messageDiv.classList.remove('show');
    setTimeout(() => messageDiv.remove(), 300);
  }, 3000);
}

// Register service worker
async function registerServiceWorker() {
  if ('serviceWorker' in navigator) {
    try {
      const registration = await navigator.serviceWorker.register('/service-worker.js');
      console.log('✅ Service Worker registered');
    } catch (error) {
      console.error('Service Worker registration failed:', error);
    }
  }
}

// Setup PWA install prompt
function setupPWAInstall() {
  let deferredPrompt;
  
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    
    const installBtn = document.createElement('button');
    installBtn.className = 'install-prompt';
    installBtn.textContent = '📲 Install App';
    installBtn.addEventListener('click', async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        console.log(`Install prompt: ${outcome}`);
        deferredPrompt = null;
        installBtn.remove();
      }
    });
    
    document.body.appendChild(installBtn);
  });
}

// Setup network monitor
function setupNetworkMonitor() {
  function updateOnlineStatus() {
    const existingIndicator = document.getElementById('offline-indicator');
    
    if (!navigator.onLine) {
      if (!existingIndicator) {
        const offlineIndicator = document.createElement('div');
        offlineIndicator.className = 'offline-indicator';
        offlineIndicator.id = 'offline-indicator';
        offlineIndicator.innerHTML = '⚠️ Offline Mode - Scan history and cached products available';
        document.body.prepend(offlineIndicator);
      }
    } else {
      if (existingIndicator) {
        existingIndicator.remove();
      }
    }
  }
  
  window.addEventListener('online', updateOnlineStatus);
  window.addEventListener('offline', updateOnlineStatus);
  updateOnlineStatus();
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', init);

// Save state before page unload
window.addEventListener('beforeunload', async () => {
  if (html5QrCode && isScanning) {
    await stopScanner();
  }
  
  // Final save
  await autoBackup();
});

// Periodic save (every minute)
setInterval(autoBackup, 60 * 1000);

// Refresh current product (called after editing)
window.refreshCurrentProduct = async function(gtin) {
  if (gtin) {
    await fetchAndDisplayProductInfo(gtin);
  }
};

// Show quick edit button after scan
function showQuickEditButton(scanData) {
  // Remove existing button
  const existingBtn = document.getElementById('quick-edit-float');
  if (existingBtn) existingBtn.remove();
  
  // Create floating edit button
  const editBtn = document.createElement('button');
  editBtn.id = 'quick-edit-float';
  editBtn.className = 'quick-edit-floating';
  editBtn.innerHTML = `
    <span class="edit-icon">✏️</span>
    <span class="edit-text">Edit Scan</span>
  `;
  editBtn.onclick = () => {
    postScanEditor.openEditor(scanData);
    editBtn.remove();
  };
  
  document.body.appendChild(editBtn);
  
  // Auto-remove after 30 seconds
  setTimeout(() => {
    if (editBtn && editBtn.parentElement) {
      editBtn.style.opacity = '0';
      setTimeout(() => editBtn.remove(), 300);
    }
  }, 30000);
}